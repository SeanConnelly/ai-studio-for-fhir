# IRIS work outputs
work/

# ── Private tooling — kept out of the PUBLIC repo ──
# These power the dev workflow but are not needed to build/run the app
# (docker compose up --build uses none of them). Anchored with a leading "/"
# so they only match at the repo root — iris/src/, frontend/package.json,
# scripts/build-*.mjs are deliberately NOT matched.
.claude/
/src/
/package.json
/package-lock.json
/tsconfig.json
/scripts/iris.sh
/docker-compose.dev.yml
/CLAUDE.md
