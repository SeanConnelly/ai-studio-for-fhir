# ── IRIS connection (used by the local npm CLI via Atelier REST) ──
IRIS_HOST=localhost
IRIS_PORT=52773
IRIS_NAMESPACE=USER
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS
IRIS_HTTPS=false

# ── LLM provider (primary demo path; provider TBD — Sean researching) ──
# LLM_MODE: external = real provider (demo default once configured), mock = offline ObjectScript fallback
LLM_MODE=mock
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# ── Embedding model (for native IRIS Vector Search; usually same vendor as LLM) ──
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
